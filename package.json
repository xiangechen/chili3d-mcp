{
    "name": "@chili3d/mcp",
    "version": "0.7.0-beta",
    "documentVersion": "0.7.1",
    "description": "Headless MCP server for Chili3D — AI-driven, editable parametric CAD generation over a shared OCCT geometry core",
    "type": "module",
    "main": "src/index.ts",
    "bin": {
        "chili3d-mcp": "dist/server.mjs"
    },
    "workspaces": [
        "chili3d/packages/*"
    ],
    "scripts": {
        "build": "rspack build",
        "dev": "rspack dev",
        "start": "node dist/server.mjs",
        "bridge": "tsx scripts/bridge.ts",
        "demo": "rspack build && node dist/demo.mjs",
        "test": "rstest"
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged"
    },
    "lint-staged": {
        "*.{ts,js,css,json,mjs}": [
            "biome check --write"
        ]
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "@chili3d/app": "*",
        "@chili3d/core": "*",
        "@chili3d/wasm": "*",
        "@rstest/core": "^0.10.0",
        "@rstest/coverage-istanbul": "^0.10.0",
        "@types/ws": "^8.18.1",
        "@rspack/cli": "^2.0.3",
        "@rspack/core": "^2.0.3",
        "@rspack/dev-server": "^2.0.0",
        "@types/jszip": "^3.4.0",
        "lint-staged": "^17.0.5",
        "tsx": "^4.22.3",
        "ts-checker-rspack-plugin": "^1.3.0",
        "typescript": "^6.0.3",
        "typescript-plugin-css-modules": "^5.2.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "ws": "^8.21.0",
        "zod": "^4.4.3",
        "jszip": "^3.10.1"
    }
}
